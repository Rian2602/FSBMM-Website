FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl pdo_mysql zip gd

WORKDIR /app

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist \
    && composer dump-autoload --no-dev --optimize --no-scripts

# Build the Vite manifest (resources/css + resources/js → public/build) that
# every @vite blade on the public site depends on. Tailwind v4 scans source
# files for utility classes, so the Blade/PHP sources must also be present in
# this stage.
FROM node:22-bookworm-slim AS frontend

WORKDIR /frontend
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY vite.config.js ./vite.config.js
COPY resources ./resources
COPY app ./app
COPY routes ./routes
RUN npm run build

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY . /app

# Copy generated Vite assets AFTER the application source so the production
# build can never be overwritten by the Docker build context.
COPY --from=frontend /frontend/public/build /app/public/build

# Pre-compile Blade views at build time: the runtime container filesystem is
# read-only, so nothing can lazily write storage/framework/views on first
# request. config:cache/route:cache are intentionally NOT run here (env vars
# differ between build and Vercel runtime; web.php also has Closure routes,
# which route:cache cannot serialize).
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && rm -f bootstrap/cache/packages.php bootstrap/cache/services.php \
    && php artisan package:discover --ansi \
    && php artisan filament:assets --ansi \
    && chown -R www-data:www-data /app

COPY Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    FILESYSTEM_PUBLIC_DRIVER=s3 \
    FILESYSTEM_LOCAL_DRIVER=s3

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
