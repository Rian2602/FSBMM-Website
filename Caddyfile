:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    # Serve Vite/static assets directly so CSS/JS/images never fall through to
    # Laravel. robots.txt is intentionally NOT matched here: it has no static
    # file (public/robots.txt) and is served by the Laravel route so the
    # Sitemap directive stays env-aware.
    #
    # /build/* filenames are content-hashed by Vite (cache-busted on every
    # rebuild), so they can be cached forever. The other static paths aren't
    # hashed, so they get a shorter, still-useful TTL instead.
    @hashed path /build/*
    handle @hashed {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @static path /favicon.ico /images/* /storage/*
    handle @static {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    handle {
        php_server {
            try_files {path} index.php
        }
    }
}
