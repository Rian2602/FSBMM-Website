APP_NAME=FSBMM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

FSBMM_ADMIN_EMAIL=admin@fsbmm.test
FSBMM_ADMIN_PASSWORD=password
# Demo SBA accounts (role sba_admin, linked to each SPM org) are seeded with this
# password. Keep it secret / change in production -- never ship a real one.
FSBMM_SBA_PASSWORD=password
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: SQLite (database/database.sqlite)
DB_CONNECTION=sqlite

# Produksi (cPanel / MySQL) — aktifkan dengan menghapus tanda # dan set DB_CONNECTION=mysql:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=fsbmm
# DB_USERNAME=fsbmm_user
# DB_PASSWORD=ganti-dengan-password-kuat

# Timeout koneksi DB (detik) — cegah request hang saat host DB tak terjangkau
# (mis. TLS handshake TiDB yang macet menunggu sampai Vercel memutus 300s).
DB_CONNECT_TIMEOUT=10

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Vercel container runtime: endpoint S3-compatible (R2/Spaces) + base URL publik
# untuk file upload. R2/Spaces wajib AWS_USE_PATH_STYLE_ENDPOINT=true.
# AWS_ENDPOINT OPSIONAL — kosongkan untuk AWS S3 klasik (endpoint diturunkan
# dari AWS_DEFAULT_REGION); isi hanya untuk R2/Spaces.
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
